{
    "workbench.colorTheme": "Dark Modern",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.experimental.modernUI": false,
    "workbench.sideBar.location": "right",
    "breadcrumbs.enabled": false,
    "workbench.colorCustomizations": {
        "editor.background": "#303030",
        "editor.foreground": "#E6E6E6",
        "editor.lineHighlightBackground": "#3A3A3A",
        "editor.selectionBackground": "#545454",
        "editor.inactiveSelectionBackground": "#484848",
        "editorCursor.foreground": "#F0F0F0",
        "sideBar.background": "#303030",
        "sideBar.foreground": "#E6E6E6",
        "sideBar.border": "#303030",
        "list.hoverBackground": "#3A3A3A",
        "list.activeSelectionBackground": "#505050",
        "list.activeSelectionForeground": "#FFFFFF",
        "activityBar.background": "#303030",
        "activityBar.border": "#303030",
        "titleBar.activeBackground": "#303030",
        "titleBar.inactiveBackground": "#303030",
        "titleBar.border": "#303030",
        "tab.activeBackground": "#303030",
        "tab.inactiveBackground": "#303030",
        "tab.border": "#303030",
        "editorGroupHeader.tabsBackground": "#303030",
        "editorGroupHeader.noTabsBackground": "#303030",
        "editorGroup.border": "#303030",
        "panel.background": "#303030",
        "panel.border": "#303030",
        "statusBar.background": "#303030",
        "statusBar.border": "#303030",
        "terminal.background": "#303030",
        "input.background": "#303030",
        "input.border": "#303030",
        "dropdown.background": "#303030",
        "dropdown.border": "#303030",
        "menu.background": "#303030",
        "menu.border": "#303030",
        "peekViewEditor.background": "#303030",
        "focusBorder": "#909090",
        "notebook.cellEditorBackground": "#303030",
        "notebook.focusedCellBorder": "#909090"
    },
    "files.exclude": {
        "**/build": true,
        "**/academic-template.sty": true,
        "**/IGPIA_Actividad_2/Trabajo/Actividad_2/config": true,
        "**/.latexmkrc": true,
        "**/*.aux": true,
        "**/*.bbl": true,
        "**/*.bcf": true,
        "**/*.bcf-SAVE-ERROR": true,
        "**/*.blg": true,
        "**/*.dvi": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.lof": true,
        "**/*.lot": true,
        "**/*.log": true,
        "**/*.nav": true,
        "**/*.out": true,
        "**/*.run.xml": true,
        "**/*.snm": true,
        "**/*.synctex.gz": true,
        "**/*.toc": true,
        "**/*.vrb": true,
        "**/*.xdv": true,
        "**/_minted-*": true,
        "**/.ipynb_checkpoints": true,
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "notebook.lineNumbers": "on",
    "latex-workshop.view.pdf.viewer": "tab",
    "chat.tools.urls.autoApprove": {
        "https://raw.githubusercontent.com": {
            "approveRequest": true,
            "approveResponse": false
        }
    },
    "chat.permissions.default": "autoApprove",
    "chat.viewSessions.orientation": "stacked",
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "terminal.integrated.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "editor.cursorBlinking": "expand",
    "editor.minimap.enabled": false
}
